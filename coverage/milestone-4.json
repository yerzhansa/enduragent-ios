	"requirements": [
		{
			"id": "B17.01/utc",
			"statement": "The calendar list's omitted end date is the phone's day, not UTC today.",
			"agreedDifference": "ADR-0083 makes the phone's time zone decide today for every read, so the list's omitted end date is the phone's day."
		},
		{
			"id": "B17.06/head-unit",
			"statement": "Delivery of an approved ride to a Garmin or Wahoo head unit is not verified.",
			"agreedDifference": "ADR-0083 leaves the head-unit half of B17.06 unverified, because the test account has no Garmin or Wahoo link."
		},
		{
			"id": "B18.07/model-call",
			"statement": "No model call judges an unfinished calendar request, and the reply's text is not held back.",
			"agreedDifference": "ADR-0083 drops npm's extra model call for an unfinished request, and replies keep streaming while the card appears after the reply ends."
		},
		{
			"id": "B20.01/zones",
			"statement": "Eligibility uses the phone's day when the phone's and the athlete's time zones differ.",
			"agreedDifference": "ADR-0083 makes the phone's time zone decide today for every calendar change, so B20.01's different-zones check is an agreed difference."
		},
		{
			"id": "X04/zone",
			"statement": "The athlete's civil date is the phone's day, not a date kept apart from the phone clock.",
			"agreedDifference": "ADR-0083 makes the phone's time zone decide today for every read and change, with no note when the athlete's zone differs."
		},
		{
			"id": "G06/midnight",
			"statement": "An approval across the athlete's midnight is judged at the phone's midnight.",
			"agreedDifference": "ADR-0083 makes the phone's time zone decide today, so G06's athlete-midnight journey is an agreed difference."
		}
	],
