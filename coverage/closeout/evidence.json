	"differences": {
		"B02.01": [
			{"recorded": {"record": "ADR-0080", "says": "B02.01/key-owner: The athlete is always the owner of the connected intervals.icu key; no other athlete ID."}}
		],
		"B02.02": [
			{"recorded": {"record": "ADR-0080", "says": "B02.02/profile-display: iOS addition: Settings shows the resolved athlete and Fitness, Fatigue and Form after connecting."}}
		],
		"B03.01": [
			{"recorded": {"record": "ADR-0080", "says": "B03.01/typed-model-id: The OpenRouter model is picked from the catalog only, with no typed model ID."}}
		],
		"B04.03": [
			{"recorded": {"record": "ADR-0080", "says": "B04.03/keychain-only: The Keychain, synced through iCloud Keychain, is the only secret store; no external secret source."}}
		],
		"B05.01": [
			{"recorded": {"record": "ADR-0080", "says": "B05.01/preferred-languages: Automatic uses the iPhone's preferred-languages list, never the message language."}}
		],
		"B05.04": [
			{"recorded": {"record": "ADR-0080", "says": "B05.04/no-override: One language picker, with no hidden override such as ENDURAGENT_LANGUAGE."}}
		],
		"B07.01": [
			{"recorded": {"record": "ADR-0080", "says": "B07.01/removed-controls: No idle-reset, daily-reset-hour, timezone or archive-retention control."}},
			{"recorded": {"record": "ADR-0080", "says": "B07.01/one-model: Compaction and memory extraction use the reply model."}}
		],
		"B08.01": [
			{"recorded": {"record": "ADR-0082", "says": "The phone keeps no Reference snapshot, so startup and a return to the app read training data live, with no refresh."}}
		],
		"B08.02": [
			{"recorded": {"record": "ADR-0082", "says": "The phone runs no refresh, so there is no refresh result; each turn reads live or says the data is unavailable."}}
		],
		"B08.04": [
			{"recorded": {"record": "ADR-0082", "says": "The 43 Reference outputs are not calculated on the phone, which keeps no snapshot."}}
		],
		"B08.05": [
			{"recorded": {"record": "ADR-0082", "says": "No Reference validation gate, refresh time or stale warning; the FTP, weight and resting heart rate bands guard the live reads."}}
		],
		"B12.03": [
			{"recorded": {"record": "ADR-0080", "says": "B12.03/real-dates: A memory event date must be a real calendar date."}}
		],
		"B13.01": [
			{"recorded": {"record": "ADR-0082", "says": "A read with no end date ends on today in the phone's time zone, not UTC today (D10)."}},
			{"recorded": {"record": "ADR-0082", "says": "The coach gets the athlete's sex and age in whole years; the date of birth stays on the phone."}},
			{"recorded": {"record": "ADR-0082", "says": "An FTP outside 50 to 600 watts is shown to the coach marked not usable."}}
		],
		"B13.02": [
			{"recorded": {"record": "ADR-0082", "says": "The detail read keeps the list fields, laps and a closed set of detail-only fields, not the whole response."}}
		],
		"B13.04": [
			{"recorded": {"record": "ADR-0082", "says": "A review may state the Load, Intensity, power and heart-rate values intervals.icu supplies, as recorded values."}}
		],
		"B13.05": [
			{"recorded": {"record": "ADR-0082", "says": "Legs are always inferred from starts within 30 minutes; intervals.icu sends no workout id or sequence."}}
		],
		"B13.06": [
			{"recorded": {"record": "ADR-0082", "says": "A start is shown as the athlete's local time and never labelled UTC; intervals.icu sends no offset."}}
		],
		"B13.07": [
			{"recorded": {"record": "ADR-0082", "says": "Text typed after /status reaches the coach (D09)."}}
		],
		"B14.02": [
			{"recorded": {"record": "ADR-0082", "says": "The zones calculator accepts an FTP sent as text."}}
		],
		"B14.04": [
			{"recorded": {"record": "ADR-0082", "says": "Text typed after /workout reaches the coach (D09)."}}
		],
		"B16.01": [
			{"recorded": {"record": "ADR-0080", "says": "B16.01/numbered-only: Choices are numbered text only, with no decision tool or decision state."}}
		],
		"MOB04": [
			{"recorded": {"record": "ADR-0083", "says": "The phone's time zone decides the athlete's day, as X04/zone and G06/midnight record."}}
		]
	},
