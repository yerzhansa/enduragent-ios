 "memory_query": {
  "properties": {
   "from": {
    "description": "Start date (inclusive), YYYY-MM-DD",
    "type": "string"
   },
   "query": {
    "description": "Case-insensitive substring filter. Omit to return everything in the range.",
    "type": "string"
   },
   "to": {
    "description": "End date (inclusive), YYYY-MM-DD",
    "type": "string"
   }
  },
  "required": [
