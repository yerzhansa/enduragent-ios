    "type": "string"
   },
   "volumeTier": {
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "weightKg": {
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "experienceLevel",
   "ftpWatts",
   "volumeTier",
   "scheduleType",
   "goalType"
