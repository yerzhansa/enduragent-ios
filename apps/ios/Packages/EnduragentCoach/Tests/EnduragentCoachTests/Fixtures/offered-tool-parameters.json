   "to"
  ],
  "type": "object"
 },
 "memory_read": {
  "properties": {},
  "type": "object"
 },
 "memory_write": {
  "properties": {
   "content": {
    "description": "The information to save",
    "type": "string"
   },
   "section": {
    "description": "Memory section to write to. REQUIRED when type='memory' — the write replaces the section content.",
    "enum": [
     "person",
     "schedule",
     "goals",
     "preferences",
     "notes",
     "medical-history",
     "cycling-profile",
     "cycling-equipment",
     "cycling-history"
    ],
    "type": "string"
   },
   "type": {
    "description": "'memory' for long-term facts, 'daily' for today's notes",
    "enum": [
     "memory",
     "daily"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "content"
  ],
  "type": "object"
 },
 "prepare_workout_changes": {
  "properties": {
   "preparation": {
    "description": "kind complete with changes; replace with base and changes; revise with base and replacements [{id, change}]; or incomplete with reason. A change is {kind: add-cycling, date, workout, trainingLoad?}, {kind: add-strength, date, name, durationMinutes, effort, description, trainingLoad?}, {kind: edit, eventId, patch} or {kind: delete, eventId}. base is {setId, revision} from get_pending_workout_changes.",
    "properties": {
     "base": {
      "properties": {
       "revision": {
        "description": "The pending review's revision",
        "minimum": 1,
        "type": "integer"
       },
       "setId": {
        "description": "The pending review's setId",
        "type": "string"
       }
      },
      "required": [
       "setId",
       "revision"
      ],
      "type": "object"
     },
     "changes": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "kind": {
      "enum": [
       "complete",
       "replace",
       "revise",
       "incomplete"
      ],
      "type": "string"
     },
     "reason": {
      "description": "Why the requested set cannot be prepared",
      "type": "string"
     },
     "replacements": {
      "items": {
       "properties": {
        "change": {
         "type": "object"
        },
        "id": {
         "description": "A pending item id",
         "type": "string"
        }
       },
       "required": [
        "id",
        "change"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "kind"
    ],
    "type": "object"
   }
  },
  "required": [
   "preparation"
  ],
  "type": "object"
 }
}
