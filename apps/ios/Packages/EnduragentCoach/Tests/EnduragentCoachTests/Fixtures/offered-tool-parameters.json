   "plan": {
    "description": "The training plan object to save",
    "properties": {
     "name": {
      "type": "string"
     },
     "phases": {
      "items": {
       "properties": {
        "durationCycles": {
         "type": "integer"
        },
        "durationWeeks": {
         "type": "integer"
        },
        "focus": {
         "type": "string"
        },
        "keyAdditions": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "name": {
         "type": "string"
        },
        "number": {
         "type": "integer"
        },
        "volumeTargets": {
         "properties": {
          "cycling": {
           "properties": {
            "hoursPerCycle": {
             "type": "number"
            },
            "sessionsPerCycle": {
             "type": "integer"
            }
           },
           "type": "object"
          }
         },
         "type": "object"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "primaryGoal": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "totalWeeks": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "zoneTables": {
      "items": {
       "properties": {
        "sport": {
         "type": "string"
        },
        "zones": {
         "items": {
          "properties": {
           "description": {
            "type": "string"
           },
           "name": {
            "type": "string"
           },
           "range": {
            "type": "string"
           }
          },
          "type": "object"
         },
         "type": "array"
        }
       },
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   }
  },
  "required": [
   "plan"
  ],
  "type": "object"
 },
 "prepare_workout_changes": {
  "properties": {
   "preparation": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "changes": {
        "items": {
         "type": "object"
        },
        "type": "array"
       },
       "kind": {
        "enum": [
         "complete"
        ],
        "type": "string"
       }
      },
      "required": [
       "changes",
       "kind"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "base": {
        "properties": {
         "revision": {
          "description": "The pending review's revision",
          "minimum": 1,
          "type": "integer"
         },
         "setId": {
          "description": "The pending review's setId",
          "type": "string"
         }
        },
        "required": [
         "setId",
         "revision"
        ],
        "type": "object"
       },
       "changes": {
        "items": {
         "type": "object"
        },
        "type": "array"
       },
       "kind": {
        "enum": [
         "replace"
        ],
        "type": "string"
       }
      },
      "required": [
       "base",
       "changes",
       "kind"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "base": {
        "properties": {
         "revision": {
          "description": "The pending review's revision",
          "minimum": 1,
          "type": "integer"
         },
         "setId": {
          "description": "The pending review's setId",
          "type": "string"
         }
        },
        "required": [
         "setId",
         "revision"
        ],
        "type": "object"
       },
       "kind": {
        "enum": [
         "revise"
        ],
        "type": "string"
       },
       "replacements": {
        "items": {
         "properties": {
          "change": {
           "type": "object"
          },
          "id": {
           "description": "A pending item id",
           "type": "string"
          }
         },
         "required": [
          "id",
          "change"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "base",
       "kind",
       "replacements"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "enum": [
         "incomplete"
        ],
        "type": "string"
       },
       "reason": {
        "description": "Why the requested set cannot be prepared",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "reason"
      ],
      "type": "object"
     }
    ],
    "description": "kind complete with changes; replace with base and changes; revise with base and replacements [{id, change}]; or incomplete with reason. A change is {kind: add-cycling, date, workout, trainingLoad?}, {kind: add-strength, date, name, durationMinutes, effort, description, trainingLoad?}, {kind: edit, eventId, patch} or {kind: delete, eventId}. base is {setId, revision} from get_pending_workout_changes."
   }
  },
  "required": [
   "preparation"
  ],
  "type": "object"
 }
}
