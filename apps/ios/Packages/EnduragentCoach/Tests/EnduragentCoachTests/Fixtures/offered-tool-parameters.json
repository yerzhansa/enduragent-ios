  ],
  "type": "object"
 },
 "memory_read": {
  "properties": {},
  "type": "object"
 },
 "memory_write": {
  "properties": {
   "content": {
    "description": "The information to save",
    "type": "string"
   },
   "section": {
    "description": "Memory section to write to. REQUIRED when type='memory' — the write replaces the section content.",
    "enum": [
     "person",
     "schedule",
     "goals",
     "preferences",
     "notes",
     "medical-history",
     "cycling-profile",
     "cycling-equipment",
     "cycling-history"
    ],
    "type": "string"
   },
   "type": {
    "description": "'memory' for long-term facts, 'daily' for today's notes",
    "enum": [
     "memory",
     "daily"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "content"
  ],
  "type": "object"
 }
